# Copy this file to .env.local and fill in real values.
# See DEPLOY.md for exactly where to get each one.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, never exposed to the browser — used for admin-level
# operations (e.g. seeding, background jobs) if/when you add them.
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar sync (owner-side)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (Resend)
RESEND_API_KEY=
